{% load custom_filters static %}
{% extends 'base.html' %}
{% load static %}

{% block title %}Search - NaijaMarket{% endblock %}

{% block content %}
<!-- Navbar -->
<nav class="navbar navbar-custom">
    <div class="container">
        <a class="navbar-brand" href="/">
            <i class="bi bi-shop"></i> NaijaMarket
        </a>
        <div>
            <a href="{% url 'marketplace:home' %}" class="btn btn-outline-light">Home</a>
        </div>
    </div>
</nav>

<!-- Search Section -->
<section class="py-5 bg-light">
    <div class="container">
        <h2 class="fw-bold mb-4">
            {% if query %}
            Search Results for "{{ query }}"
            {% else %}
            Browse All Products
            {% endif %}
        </h2>

        <div class="row">
            <!-- Filters Sidebar -->
            <div class="col-lg-3 mb-4">
                <div class="card border-0 shadow">
                    <div class="card-body">
                        <h5 class="fw-bold mb-3">
                            <i class="bi bi-funnel"></i> Filters
                        </h5>

                        <form method="GET" action="{% url 'marketplace:search_products' %}">
                            <!-- Search -->
                            <div class="mb-3">
                                <label class="form-label">Search</label>
                                <input type="text" name="q" class="form-control" value="{{ query }}"
                                    placeholder="Product name...">
                            </div>

                            <!-- Category -->
                            <div class="mb-3">
                                <label class="form-label">Category</label>
                                <select name="category" class="form-select">
                                    <option value="">All Categories</option>
                                    <option value="food-agro" {% is_selected category "food-agro" %}>Food & Agro
                                    </option>
                                    <option value="electronics" {% is_selected category "electronics" %}>Electronics
                                    </option>
                                    <option value="fashion" {% is_selected category "fashion" %}>Fashion</option>
                                    <option value="building" {% is_selected category "building" %}>Building Materials
                                    </option>
                                    <option value="services" {% is_selected category "services" %}>Services</option>
                                    <option value="auto" {% is_selected category "auto" %}>Automobile</option>
                                </select>
                            </div>

                            <!-- State -->
                            <div class="mb-3">
                                <label class="form-label">State</label>
                                <select name="state" class="form-select">
                                    <option value="">All States</option>
                                    <option value="Lagos" {% is_selected state "Lagos" %}>Lagos</option>
                                    <option value="Abuja" {% is_selected state "Abuja" %}>Abuja</option>
                                    <option value="Kano" {% is_selected state "Kano" %}>Kano</option>
                                    <option value="Rivers" {% is_selected state "Rivers" %}>Rivers</option>
                                    <option value="Oyo" {% is_selected state "Oyo" %}>Oyo</option>
                                    <option value="Anambra" {% is_selected state "Anambra" %}>Anambra</option>
                                    <option value="Delta" {% is_selected state "Delta" %}>Delta</option>
                                </select>
                            </div>

                            <!-- Delivery -->
                            <div class="mb-3">
                                <div class="form-check">
                                    <input type="checkbox" name="delivery" value="yes" class="form-check-input"
                                        id="deliveryCheck" {% is_checked delivery "yes" %}>
                                    <label class="form-check-label" for="deliveryCheck">
                                        Delivery Available
                                    </label>
                                </div>
                            </div>

                            <button type="submit" class="btn btn-success w-100">
                                <i class="bi bi-search"></i> Apply Filters
                            </button>
                        </form>

                        <a href="{% url 'marketplace:search_products' %}" class="btn btn-outline-secondary w-100 mt-2">
                            <i class="bi bi-x-circle"></i> Clear Filters
                        </a>
                    </div>
                </div>
            </div>

            <!-- Results -->
            <div class="col-lg-9">
                {% if products %}
                <p class="text-muted mb-4">{{ products.count }} product(s) found</p>
                <div class="row g-4">
                    {% for product in products %}
                    <div class="col-md-6 col-lg-4">
                        <div class="product-card">
                            {% if product.image %}
                            <img src="{{ product.image.url }}" class="product-image" alt="{{ product.name }}">
                            {% else %}
                            <div class="bg-light d-flex align-items-center justify-content-center"
                                style="height: 200px;">
                                <i class="bi bi-image display-4 text-muted"></i>
                            </div>
                            {% endif %}
                            <div class="product-card-body">
                                <span class="product-category">{{ product.get_category_display }}</span>
                                <h6 class="product-title">{{ product.name }}</h6>
                                <p class="text-success fw-bold mb-1">₦{{ product.price }}</p>
                                <p class="text-muted small mb-2">
                                    <i class="bi bi-geo-alt"></i> {{ product.location }}, {{ product.state }}
                                </p>
                                <a href="{% url 'marketplace:product_detail' product.id %}"
                                    class="btn btn-sm btn-outline-success w-100">
                                    View Details
                                </a>
                            </div>
                        </div>
                    </div>
                    {% endfor %}
                </div>
                {% else %}
                <div class="text-center py-5">
                    <i class="bi bi-search display-1 text-muted"></i>
                    <h4 class="mt-3">No products found</h4>
                    <p class="text-muted">Try adjusting your search or filters</p>
                    <a href="{% url 'marketplace:search_products' %}" class="btn btn-success">
                        View All Products
                    </a>
                </div>
                {% endif %}
            </div>
        </div>
    </div>
</section>
{% endblock %}